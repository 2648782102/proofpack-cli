{
  "name": "proofpack-cli",
  "version": "0.1.0",
  "description": "Local acceptance reports for AI-assisted code changes",
  "type": "module",
  "engines": { "node": ">=24" },
  "bin": { "proofpack": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
