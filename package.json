{
  "name": "proofpack-cli",
  "version": "0.2.0",
  "description": "Local acceptance reports for AI-assisted code changes",
  "type": "module",
  "engines": { "node": ">=24" },
  "bin": { "proofpack": "dist/cli.js", "proofpack-mcp": "dist/mcp.js" },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE", "docs/RELEASE.md", "docs/MCP.md"],
  "keywords": ["git", "cli", "mcp", "acceptance-report", "developer-tools", "local-first"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2648782102/proofpack-cli.git"
  },
  "homepage": "https://github.com/2648782102/proofpack-cli#readme",
  "bugs": {
    "url": "https://github.com/2648782102/proofpack-cli/issues"
  },
  "publishConfig": { "access": "public" },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:mcp": "tsx src/mcp.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
